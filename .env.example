# Copy file này thành .env rồi điền giá trị. KHÔNG chia sẻ / đưa .env lên git.

# PostgreSQL
DATABASE_URL=host=<db-host> port=5432 dbname=<db-name> user=<db-user> password=<db-password>

# Mật khẩu GDT theo MST công ty (ký tự '-' trong MST đổi thành '_').
# Tài khoản đăng nhập (vd 1201496252-U002) khai báo bằng lệnh add-company --username.
HDT_PASSWORD_1201496252=<mat-khau-gdt>

# Tuỳ chọn
# INVOICE_OUTPUT_DIR=C:\Project\scan-captcha-project\output
# INVOICE_TYPES=mua-all,ban-all
# Lưu ZIP gốc tải từ Thuế vào output\temp\ để đối chiếu (1 = bật, 0 = tắt)
# INVOICE_SAVE_ZIP=1
# Nguồn danh sách HĐ: excel = nút "Xuất Excel" của cổng (mặc định; 1 request mỗi loại HĐ,
# file gốc lưu ở output\list\) | json = API danh sách phân trang (cách cũ, dự phòng)
# INVOICE_LIST_SOURCE=excel

# ---------------------------------------------------------------------------
# Hộp mail hóa đơn (lệnh `mail`, bước mail trong `tick`). Không có INVOICE_MAIL_USER → bỏ qua mail.
# Chỉ ĐỌC (không đánh dấu đã đọc, không xóa). Chỉ IMAP qua SSL (cổng 993), không hỗ trợ POP3.
# ---------------------------------------------------------------------------
INVOICE_MAIL_USER=<dia-chi-mail>
# Thư mục đọc; nhiều thư mục cách nhau dấu phẩy (vd bộ lọc chuyển mail HĐ sang HDDT → INBOX,HDDT).
# Tên có dấu tiếng Việt cũng được. Mail bị chuyển thư mục không bị xử lý lại.
INVOICE_MAIL_FOLDER=INBOX,HDDT
# Chỉ xét mail nhận trong N ngày gần nhất
INVOICE_MAIL_DAYS=7
# INVOICE_MAIL_PORT=993

# Công tắc cách đăng nhập — chọn 1 trong 3:
INVOICE_MAIL_AUTH=password

# (1) password — mail công ty tự host (Hanbiro, Zimbra, cPanel...), hoặc Gmail/Yahoo dùng
#     MẬT KHẨU ỨNG DỤNG (bật xác minh 2 bước → tạo App Password; mật khẩu thường bị từ chối).
#     Host: mail công ty mail.webcashvietnam.com · Gmail imap.gmail.com · Yahoo imap.mail.yahoo.com
INVOICE_MAIL_HOST=mail.webcashvietnam.com
INVOICE_MAIL_PASSWORD=<mat-khau-hoac-app-password>

# (2) oauth2_microsoft — Microsoft 365 / Outlook (Microsoft đã tắt IMAP đăng nhập bằng mật khẩu).
#     Cần admin: đăng ký app trong Entra ID → cấp quyền ứng dụng "IMAP.AccessAsApp" (Office 365
#     Exchange Online) → admin consent → đăng ký service principal trong Exchange và cấp quyền đọc
#     hộp mail (Add-MailboxPermission). Host mặc định outlook.office365.com.
# INVOICE_MAIL_MS_TENANT_ID=<tenant-id>
# INVOICE_MAIL_MS_CLIENT_ID=<application-client-id>
# INVOICE_MAIL_MS_CLIENT_SECRET=<client-secret>

# (3) oauth2_google — Google Workspace khi admin chặn App Password. Tạo OAuth client (Google Cloud
#     Console, bật Gmail API), cấp quyền 1 lần với scope https://mail.google.com/ để lấy refresh token.
#     Host mặc định imap.gmail.com.
# INVOICE_MAIL_GOOGLE_CLIENT_ID=<client-id>
# INVOICE_MAIL_GOOGLE_CLIENT_SECRET=<client-secret>
# INVOICE_MAIL_GOOGLE_REFRESH_TOKEN=<refresh-token>

# Chỉ dùng khi chạy test DB (pytest tests/test_invoice_store.py)
# TEST_DATABASE_URL=postgresql://user:password@localhost:5432/invoices_dev
