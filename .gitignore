# Byte-compiled / caches
__pycache__/
*.py[cod]

# Training artefacts -- large, reproducible from the dataset + config
runs/
weights/
*.pt
*.onnx

# Dataset index cache (rebuilt automatically; keyed by dir signature)
.cache/

# Report / scratch output
out/

# Virtualenv
.venv/
venv/
env/

# Tooling
.pytest_cache/
.ipynb_checkpoints/
.claude/

# Bí mật — chỉ nằm trong .env, KHÔNG đưa lên repo
.env
.env.*
!.env.example

# Dữ liệu train captcha (lớn) + nhật ký đổi nhãn của dataset
env_pass/
env_*manifest.json
fix_case_*_manifest.json

# Dữ liệu hóa đơn thật của công ty (XML/PDF/mail/log) và file tạm
output/
temp/
docs/*.backup-*.xlsx
~$*

# Repo tham khảo riêng (có .git riêng) và project mẫu không liên quan
example/
Sample/

# Build C# (captcha-botdetect)
bin/
obj/

# Model đang dùng thật (Git LFS, xem .gitattributes) — chỉ best.pt + history.csv:
#   g_600x120 đăng nhập Thuế | g_150x34 EasyInvoice | g_80x30 VNPT | g_1500x350 Visnam
# Dùng thêm nhóm nào (adapter mới) thì thêm 1 dòng !runs/<nhóm>/ ở đây.
!runs/
runs/*
!runs/g_600x120/
!runs/g_150x34/
!runs/g_80x30/
!runs/g_1500x350/
runs/*/*
!runs/*/best.pt
!runs/*/history.csv
