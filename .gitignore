# Byte-compiled / caches
__pycache__/
*.py[cod]

# Training artefacts -- large, reproducible from the dataset + config
runs/
weights/
*.pt
*.onnx

# Dataset index cache (rebuilt automatically; keyed by dir signature)
.cache/

# Report / scratch output
out/

# Virtualenv
.venv/
venv/
env/

# Tooling
.pytest_cache/
.ipynb_checkpoints/
.claude/

# Bí mật — chỉ nằm trong .env, KHÔNG đưa lên repo
.env
.env.*
!.env.example

# Dữ liệu train captcha (lớn) + nhật ký đổi nhãn của dataset
env_pass/
env_*manifest.json
fix_case_*_manifest.json

# Dữ liệu hóa đơn thật của công ty (XML/PDF/mail/log) và file tạm
output/
temp/
docs/*.backup-*.xlsx
~$*

# Repo tham khảo riêng (có .git riêng) và project mẫu không liên quan
example/
Sample/

# Build C# (captcha-botdetect)
bin/
obj/

# Model đang dùng thật (Git LFS, xem .gitattributes) — chỉ best.pt + history.csv:
#   g_600x120 đăng nhập Thuế | g_150x34 EasyInvoice | g_80x30 VNPT | g_1500x350 Visnam | g_300x75 CyberLotus
# Dùng thêm nhóm nào (adapter mới) thì thêm 1 dòng !runs/<nhóm>/ ở đây.
!runs/
runs/*
!runs/g_600x120/
!runs/g_150x34/
!runs/g_80x30/
!runs/g_1500x350/
!runs/g_300x75/
# 27/10: Megabiz | PVOIL | Nhóm Mây
!runs/g_120x38/
!runs/g_194x35/
!runs/g_120x40_cloud/
runs/*/*
!runs/*/best.pt
!runs/*/history.csv
# g_200x70 (Thái Sơn): bản height=32, test 89,24%, meta đã vá charset (23/10 dùng lại cho adapter)
!runs/g_200x70/
# g_180x50_vn (vninvoice.vn): adapter vninvoice 02/11, cổng thật 28/30, HĐ thật 15/15
!runs/g_180x50_vn/
# g_160x75 (hoadon30s / P.A Việt Nam): train 02–03/11, test 86,16%; adapter pavietnam chưa dùng
!runs/g_160x75/

# WeInvoice UI Spec v1.0 (PO bàn giao 30/10): giữ bản bàn giao (00/01/02, bat, 2 zip) + weinvoice-web/
# (mã nguồn UI để đọc/grep, trùng nội dung WeInvoice_UI_Source_v1.0.zip). Bỏ các bản giải nén tay khác
# (trùng 100% zip), thư mục chay_prototype.bat tự giải nén (kèm data/state.json) và file build Next.js.
# TestData/ chỉ giữ thư mục: dev hay bỏ XML/PDF thật vào để thử prototype.
docs/WeInvoice_UI_Spec_v1.0/WeInvoice_Prototype_v1.0/
docs/WeInvoice_UI_Spec_v1.0/WeInvoice_UI_Source_v1.0/
docs/WeInvoice_UI_Spec_v1.0/WeInvoice_Prototype/
docs/WeInvoice_UI_Spec_v1.0/**/node_modules/
docs/WeInvoice_UI_Spec_v1.0/**/.next/
docs/WeInvoice_UI_Spec_v1.0/**/*.tsbuildinfo
docs/WeInvoice_UI_Spec_v1.0/TestData/**
!docs/WeInvoice_UI_Spec_v1.0/TestData/**/
!docs/WeInvoice_UI_Spec_v1.0/TestData/**/.gitkeep
